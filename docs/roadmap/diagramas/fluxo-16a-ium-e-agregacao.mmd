flowchart TB
  classDef trava fill:#fff0e2,stroke:#c24f00,stroke-width:2px,color:#17191c
  classDef passo fill:#ffffff,stroke:#565b63,color:#17191c
  classDef fim fill:#e3f4ea,stroke:#17703f,stroke-width:2px,color:#17191c
  classDef bloqueio fill:#fde8e6,stroke:#b42318,stroke-width:2px,color:#17191c
  subgraph O["1 · O que a lei exige da embalagem (obrigatório)"]
    direction LR
    A1["Lote embalado"]:::passo --> A2{"Lote certificado pela<br/>Pessoa Delegada?"}:::trava
    A2 -- não --> X1(["Sem etiqueta do lote"]):::bloqueio
    A2 -- sim --> A3["Etiqueta com registro, lote,<br/>fabricação, validade<br/>e código da bula digital"]:::trava
  end
  subgraph P["2 · Recurso opcional da empresa"]
    direction LR
    B1["Número de série<br/>por embalagem"]:::trava --> B2{"Série repetida<br/>ou acima do embalado?"}:::trava
    B2 -- sim --> X2(["Geração recusada"]):::bloqueio
    B2 -- não --> B3["Caixas de transporte<br/>com código próprio"]:::trava
  end
  subgraph C["3 · Depois de expedida"]
    direction LR
    C1{"Desfazer caixa<br/>já expedida?"}:::trava
    C1 -- sim --> X3(["Recusado"]):::bloqueio
    C1 -- não --> C2(["Cada embalagem em<br/>uma só caixa"]):::fim
  end
  O --> P --> C
