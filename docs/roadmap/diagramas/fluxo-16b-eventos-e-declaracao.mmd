flowchart TB
  classDef trava fill:#fff0e2,stroke:#c24f00,stroke-width:2px,color:#17191c
  classDef passo fill:#ffffff,stroke:#565b63,color:#17191c
  classDef fim fill:#e3f4ea,stroke:#17703f,stroke-width:2px,color:#17191c
  classDef bloqueio fill:#fde8e6,stroke:#b42318,stroke-width:2px,color:#17191c
  subgraph R["1 · Registrar o evento"]
    direction LR
    A1["Evento da embalagem<br/>(produção, entrega, recebimento...)"]:::passo --> A2{"Na ordem certa, lote liberado<br/>e venda correspondente?"}:::trava
    A2 -- não --> X1(["Evento recusado"]):::bloqueio
    A2 -- sim --> A3["Evento gravado, IUM muda<br/>de situação só após o envio"]:::trava
  end
  subgraph D["2 · Declarar à ANVISA"]
    direction LR
    B1["Arquivo assinado com<br/>certificado digital"]:::trava --> B2{"ANVISA devolveu<br/>protocolo?"}:::trava
    B2 -- não --> X2(["Fica pendente, com aviso,<br/>nunca como enviado"]):::bloqueio
    B2 -- sim --> B3(["Enviado, com protocolo<br/>guardado"]):::fim
  end
  subgraph C["3 · Corrigir e consultar"]
    direction LR
    C1["Retificação com motivo,<br/>original preservado"]:::trava --> C2(["Linha do tempo de cada IUM<br/>e consulta por lote"]):::fim
  end
  R --> D --> C
